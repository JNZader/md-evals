# Database
DATABASE_URL=postgresql+asyncpg://md_evals:md_evals@localhost:5432/md_evals

# JWT
JWT_SECRET=change-me-generate-a-random-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Encryption — master key for AES-256-GCM provider key encryption.
# Accepts: 64-char hex string, 32-byte base64, or any passphrase (SHA-256 derived).
ENCRYPTION_KEY=change-me-to-a-long-random-secret

# CORS (comma-separated origins)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# Server
DEBUG=true

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextPack.v0 offline fixture contract",
  "description": "Test-only transport-neutral envelope. Semantic validation binds every field to synthetic source manifests. Estimates cover evidence quotes only, never complete model context or provider telemetry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "revision",
    "producer",
    "freshness",
    "git_state",
    "providers",
    "evidence",
    "conflicts",
    "budget",
    "trace"
  ],
  "properties": {
    "schema_version": {
      "const": "ContextPack.v0"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "freshness": {
      "enum": [
        "fresh",
        "stale",
        "unknown"
      ]
    },
    "git_state": {
      "enum": [
        "clean",
        "dirty",
        "unknown"
      ]
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "trace": {
      "$ref": "#/$defs/trace"
    }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "instance"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "instance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instance",
        "status",
        "detail"
      ],
      "properties": {
        "kind": {
          "enum": [
            "structure",
            "memory"
          ]
        },
        "instance": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "empty",
            "error",
            "unsupported"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "repository",
        "revision",
        "producer_instance",
        "source_id",
        "path",
        "line",
        "quote",
        "claim",
        "value",
        "freshness",
        "git_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "structure",
            "memory"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "producer_instance": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "git_state": {
          "enum": [
            "clean",
            "dirty",
            "unknown"
          ]
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "estimated_tokens",
        "measurement",
        "algorithm",
        "scope",
        "truncated",
        "dropped_ids"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "measurement": {
          "const": "estimate"
        },
        "algorithm": {
          "const": "utf8_quote_bytes_div4_ceil_v0"
        },
        "scope": {
          "const": "evidence_quotes"
        },
        "truncated": {
          "type": "boolean"
        },
        "dropped_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval_digest",
        "provenance_digest"
      ],
      "properties": {
        "retrieval_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provenance_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
